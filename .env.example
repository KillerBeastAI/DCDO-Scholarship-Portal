# ============================================================
# Davao City Scholarship Programs Portal — Environment Config
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=scholarship_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=scholarship_portal
DATABASE_URL=postgres://scholarship_admin:change_me_in_production@localhost:5433/scholarship_portal

# ── Backend Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-random-string-AAAAAAAAAAAAAAAAAAAAAA
JWT_REFRESH_SECRET=replace-with-another-64-char-random-string-BBBBBBBBBBBBBBBBB
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth 2.0 ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── Frontend URL (CORS origin) ───────────────────────────────
FRONTEND_URL=http://localhost:3000
